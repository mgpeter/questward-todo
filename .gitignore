##############################################################################
# JetBrains Rider / ReSharper
#
# *.DotSettings is shared team configuration and stays tracked;
# only the per-developer .user layer is ignored.
##############################################################################
.idea/
*.sln.iml
*.slnx.iml
*.DotSettings.user
_ReSharper*/
*.[Rr]e[Ss]harper
.fake/

##############################################################################
# VS Code
#
# Allowlist rather than blocklist: launch.json and tasks.json are the
# documented F5 debug setup and belong in the repo, but anything VS Code or an
# extension decides to drop in here (debug profiles, caches) does not.
##############################################################################
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json
!.vscode/extensions.json

##############################################################################
# Node / Vite
##############################################################################
node_modules/
dist/
.vite/
.eslintcache
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

##############################################################################
# Questward
##############################################################################

# Vite writes the production SPA straight into the API's static root.
# It is build output, not source: `npm run build` regenerates it.
src/TodoApp.Api/wwwroot/

# Screenshots produced by scripts/verify-ui.mjs.
artifacts/

# Local overrides. .env.example is tracked; .env is yours.
.env
.env.local
appsettings.Local.json

##############################################################################
# Credentials and certificates
##############################################################################
*.pfx
*.p12
secrets.json

##############################################################################
# Operating system
##############################################################################
.DS_Store
._*
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*.swp
*~
