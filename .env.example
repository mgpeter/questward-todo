# Copy to .env to configure the compose stack.
#
# src/TodoApp.AppHost reads this same file, so `aspire run` and `docker compose up` are
# configured once rather than twice. POSTGRES_USER and POSTGRES_PASSWORD also become the
# credentials of the AppHost's own Postgres container, which is a separate database on its
# own volume - see DEC-016.

# --- Database ---------------------------------------------------------------
# The defaults are fine for a machine only you can reach; change the password
# before exposing this to anything else.
POSTGRES_DB=questward
POSTGRES_USER=questward
POSTGRES_PASSWORD=questward

# Host port the app is published on.
QUESTWARD_PORT=8080

# --- Auth0 (required) -------------------------------------------------------
# The app refuses to start without all three. None of them are secret: a PKCE
# flow has no client secret, and the SPA client id is public by design.
#
# From the Auth0 dashboard:
#   AUTH0_DOMAIN        Applications -> your SPA -> Domain
#   AUTH0_SPA_CLIENT_ID Applications -> your SPA -> Client ID
#   AUTH0_AUDIENCE      Applications -> APIs -> your API -> Identifier
#
# On the SPA application also set Allowed Callback URLs, Logout URLs and Web
# Origins to the origins you use, or sign-in fails with a callback mismatch:
#   http://localhost:5173, http://localhost:5080, http://localhost:8080
#
# That list is unchanged since the gateway arrived: it deliberately took 5080, the port the
# API used to answer on, so no Auth0 configuration had to move. 5080 is now the front door
# under the AppHost, 8080 the front door under Compose, and 5173 the bare Vite dev server.
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_SPA_CLIENT_ID=your-spa-client-id
AUTH0_AUDIENCE=https://questward.api

# --- Shared host (Asgard) only -----------------------------------------------
# On the shared host the tenant .env is RENDERED FROM AZURE KEY VAULT by
# infra-render-env and lives at /srv/infra/tenants/questward/.env - it is not
# this file, and it must never be edited by hand or committed.
#
# DB_HOST is the single value that differs between the two deployments: the
# host's shared Postgres cluster answers to `postgres`, a self-provided one to
# `db` (the default). Everything else is identical, which is the point.
DB_HOST=postgres
