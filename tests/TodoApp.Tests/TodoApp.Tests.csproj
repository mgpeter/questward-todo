<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xUnit v3 test projects are executables, not libraries. -->
    <OutputType>Exe</OutputType>
    <!-- xUnit1051 wants TestContext.Current.CancellationToken threaded through every
         EF call. These run against a local container and finish in milliseconds, so the
         token would be pure noise at ~16 call sites for no practical responsiveness gain. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <!-- Matches the 10.0.11 pins in TodoApp.Data; see the comment there for why. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <!-- Real Postgres: per-user scoping is enforced in SQL, so an in-memory provider
         would not exercise the queries or the constraints that make it correct. -->
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TodoApp.Api\TodoApp.Api.csproj" />
    <ProjectReference Include="..\..\src\TodoApp.Data\TodoApp.Data.csproj" />
    <ProjectReference Include="..\..\src\TodoApp.Models\TodoApp.Models.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
