{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",

  // The API keeps its /api prefix, so there is deliberately no PathRemovePrefix transform:
  // /api/config arrives upstream as /api/config. That is why the SPA's relative fetches and
  // SystemEndpoints need no change at all to work behind the proxy.
  "ReverseProxy": {
    "Routes": {
      "api": {
        "ClusterId": "api",
        "Order": 0,
        "Match": {
          "Path": "/api/{**catch-all}"
        },
        // Set, not Append: a client-supplied X-Forwarded-For is discarded here rather than
        // being passed through to an API that trusts it. Explicit because the API's
        // per-address rate limit depends on it.
        "Transforms": [
          { "X-Forwarded": "Set", "Prefix": "Off" }
        ]
      }
    },
    "Clusters": {
      "api": {
        "Destinations": {
          "api": { "Address": "http://api" }
        }
      }
    }
  }
}
